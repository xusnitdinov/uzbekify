{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://uzbekify.dev/schemas/lint.schema.json",
  "title": "uzpro lint --format json output",
  "type": "object",
  "required": ["file", "score", "band", "humanVoiceBonus", "humanVoiceSignals", "findings", "textLength"],
  "properties": {
    "file": { "type": "string" },
    "score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "band": { "type": "string", "enum": ["publish", "minor polish", "needs rewrite", "rewrite from scratch"] },
    "humanVoiceBonus": { "type": "integer", "minimum": 0, "maximum": 6 },
    "humanVoiceSignals": { "type": "array", "items": { "type": "string" } },
    "textLength": { "type": "integer" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule", "family", "severity", "match", "count", "message"],
        "properties": {
          "rule": { "type": "string" },
          "family": { "type": "string" },
          "severity": { "type": "string", "enum": ["error", "warn", "info"] },
          "match": { "type": "string" },
          "count": { "type": "integer", "minimum": 1 },
          "message": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "column": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
